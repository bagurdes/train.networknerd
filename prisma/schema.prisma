// Network Nerd — data model
// ----------------------------------------------------------------------------
// Domain: classes contain users (instructors + students) and reference one
// course; courses contain ordered modules via a join table (CourseModule) so
// the same module can be reused across multiple courses; modules contain
// ordered questions; students submit attempts on questions, which Claude grades.
//
// Key architectural decisions:
//   - Module is now standalone (no courseId). Courses reference modules through
//     CourseModule, which carries the per-course ordering.
//   - The same module can appear in many courses at different positions.
//   - The Virtual Class / paid-enrollment seam is intentional but minimal:
//       Class.isVirtual           — flag for the public catalog (Phase 3)
//       EnrollmentSource.SELF_ENROLLED — set by the future Stripe webhook
//   Adding payments later does NOT require a schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Enums ----------------------------------------------------------------

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum MembershipRole {
  INSTRUCTOR
  STUDENT
}

enum EnrollmentSource {
  ASSIGNED // Added by an admin or instructor.
  SELF_ENROLLED // Phase 3: student signed up & paid for a Virtual Class.
}

enum AttemptVerdict {
  PENDING
  CORRECT
  INCORRECT
  UNSURE
}

enum MediaKind {
  IMAGE
  GIF
  VIDEO
}

// ----- Users ----------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships ClassMembership[]
  attempts    Attempt[]
  resetTokens PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ----- Curriculum: Course → CourseModule → Module → Question ---------------

model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  downloadUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseModules CourseModule[]
  classes       Class[]
}

// Join table: a Module can belong to many Courses, each with its own ordering.
model CourseModule {
  id       String @id @default(cuid())
  courseId String
  moduleId String
  // The position of this module within this specific course.
  order    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])    // no two modules share the same position in a course
  @@index([moduleId])
  @@index([courseId])
}

// Module is standalone — it can be reused across many courses.
model Module {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseModules CourseModule[]
  questions     Question[]
  media         Media[]
}

model Question {
  id            String   @id @default(cuid())
  moduleId      String
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prompt        String   @db.Text
  correctAnswer String   @db.Text
  explanation   String   @db.Text
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts Attempt[]
  media    Media[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Media {
  id         String    @id @default(cuid())
  url        String
  kind       MediaKind
  caption    String?
  moduleId   String?
  questionId String?
  module     Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([moduleId])
  @@index([questionId])
}

// ----- Classes (offering of a course to a cohort) ---------------------------

model Class {
  id        String    @id @default(cuid())
  name      String
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  startDate DateTime
  endDate   DateTime?
  capacity  Int       @default(30)
  isVirtual Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships ClassMembership[]

  @@index([courseId])
}

model ClassMembership {
  id       String           @id @default(cuid())
  classId  String
  userId   String
  role     MembershipRole
  source   EnrollmentSource @default(ASSIGNED)
  joinedAt DateTime         @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

// ----- Attempts (graded answers) -------------------------------------------

model Attempt {
  id            String         @id @default(cuid())
  userId        String
  questionId    String
  studentAnswer String         @db.Text
  verdict       AttemptVerdict @default(PENDING)
  aiRationale   String?        @db.Text
  aiModel       String?
  gradedAt      DateTime?
  createdAt     DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([questionId])
}
