# Network Nerd — environment variables
# Copy this file to .env.local for local development.
# In production, set these in Railway's web service "Variables" tab.

# --- Database ---------------------------------------------------------------
# Postgres connection string. Railway gives you this automatically when you add
# a Postgres plugin to your project. For local dev, point at the same Railway
# database (or eventually a separate dev database).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth -------------------------------------------------------------------
# Secret used by Auth.js (NextAuth) to sign session cookies / JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Public URL of the app. Used by Auth.js for callback URLs and by emails.
# Local dev: http://localhost:3000
# Production: https://train.networknerd.guru
NEXTAUTH_URL="http://localhost:3000"

# --- Anthropic (AI grading) -------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: which Claude model to use for grading. Default: claude-haiku-4-5.
# Use claude-sonnet-4-6 for harder questions (higher cost / accuracy).
ANTHROPIC_GRADING_MODEL="claude-haiku-4-5-20251001"

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY="re_..."

# Sender address used for password reset and class invitation emails.
# Must be on a domain you've verified in Resend.
EMAIL_FROM="Network Nerd <noreply@networknerd.guru>"

# --- First-run setup --------------------------------------------------------
# Used ONLY by `npm run first-run-setup` to bootstrap the first Admin user.
# Delete or unset after the script runs.
FIRST_ADMIN_EMAIL="ross@networknerd.guru"
FIRST_ADMIN_NAME="Ross"
